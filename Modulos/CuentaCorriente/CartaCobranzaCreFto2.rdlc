            </Style>
          </Paragraph>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Por medio de la presente nos dirigimos a usted para informarle que no habiendo obtenido respuesta a nuestro requerimiento de pago,</Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Courier New</FontFamily>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontStyle>Normal</FontStyle>
                  <FontFamily>Arimo</FontFamily>
                  <FontSize>11pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>None</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
                <Value>reiteramos</Value>
                <Style>
                  <FontStyle>Italic</FontStyle>
                  <FontFamily>Courier New</FontFamily>
                  <FontSize>8pt</FontSize>
                  <FontWeight>Normal</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                  <Color>#000000</Color>
                </Style>
              </TextRun>
              <TextRun>
